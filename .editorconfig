# Mirrors the checks in scripts/ci/hygiene.sh.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

# No [*.md] exemption: scripts/ci/hygiene.sh rejects trailing whitespace in
# every text file, so exempting Markdown here would just turn CI red. Use a
# backslash or a blank line for a hard break instead of two trailing spaces.

[Makefile]
indent_style = tab
